<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:gdpr="http://namespaces.plone.org/gdpr"
    i18n_domain="collective.privacy"
    >

  <utility
      provides="collective.privacy.interfaces.ILawfulBasis"
      name="contract"
      component="collective.privacy.lawful_basis.contract"
      />

  <utility
      provides="collective.privacy.interfaces.ILawfulBasis"
      name="consent"
      component="collective.privacy.lawful_basis.consent"
      />

  <utility
      provides="collective.privacy.interfaces.ILawfulBasis"
      name="legal_obligation"
      component="collective.privacy.lawful_basis.legal_obligation"
      />

  <utility
      provides="collective.privacy.interfaces.ILawfulBasis"
      name="legitimate_interest"
      component="collective.privacy.lawful_basis.legitimate_interest"
      />

  <utility
      provides="collective.privacy.interfaces.ILawfulBasis"
      name="public_task"
      component="collective.privacy.lawful_basis.public_task"
      />

  <utility
      provides="collective.privacy.interfaces.ILawfulBasis"
      name="vital_interest"
      component="collective.privacy.lawful_basis.vital_interest"
      />

</configure>
